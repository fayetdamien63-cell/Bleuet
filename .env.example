# --- Claude (obligatoire) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Météo ---
# Par défaut : Open-Meteo, gratuit et SANS clé API. Rien à faire.
BLEUET_WEATHER_PROVIDER=openmeteo    # openmeteo | openweathermap | mock
# Uniquement si tu choisis openweathermap : https://openweathermap.org/api
OPENWEATHER_API_KEY=

# --- Emplacement ---
# La ville suffit : Open-Meteo la géocode tout seul. Renseigne les coordonnées
# pour éviter cet appel au démarrage, ou si ta commune est ambiguë.
BLEUET_CITY=Clermont-Ferrand
BLEUET_LATITUDE=
BLEUET_LONGITUDE=

# --- Surcharges éventuelles du fichier config/config.yaml ---
# BLEUET_CONFIG=config/config.yaml
