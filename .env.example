# --- Claude (obligatoire) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Météo (optionnel : sans clé, le provider "mock" est utilisé) ---
# https://openweathermap.org/api -> plan gratuit
OPENWEATHER_API_KEY=
BLEUET_WEATHER_PROVIDER=mock         # mock | openweathermap

# --- Emplacement (utilisé par la météo et le prompt) ---
BLEUET_LATITUDE=45.7772
BLEUET_LONGITUDE=3.0870
BLEUET_CITY=Clermont-Ferrand

# --- Surcharges éventuelles du fichier config/config.yaml ---
# BLEUET_CONFIG=config/config.yaml
